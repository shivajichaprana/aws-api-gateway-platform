# Terraform
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Local variable files may contain account-specific values
*.tfvars
*.tfvars.json
!example.tfvars

# Editors
.idea/
.vscode/
*.swp
.DS_Store

# Packaged function bundles, written at plan time next to the module that
# builds them
.terraform-build/

# Python bytecode, which a local syntax check leaves behind
__pycache__/
*.py[cod]

# Saved plans and the test runner's cache, both written by the Makefile
.pytest_cache/
